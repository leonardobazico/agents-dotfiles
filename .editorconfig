root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.py]
indent_size = 4

[Makefile]
indent_style = tab

# mdformat owns Markdown layout and indents list continuations by the marker width.
[*.md]
indent_size = unset

# Tabs in TSV are column separators, not indentation.
[*.tsv]
indent_style = unset
indent_size = unset
